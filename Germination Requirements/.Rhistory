####import data####
data<-read.csv('WesBurSur.csv')
####load library####
library(ggplot2)
library(dplyr)
library(tidyr)
library(GerminaR)
library(brglm2)
library(emmeans)
data <- data %>%
mutate(Soil = as.character(Soil),
Soil = ifelse(Soil %in% c("H1", "H2"), "Hester", Soil),
Soil = factor(Soil))
long<- data %>%
pivot_longer(
cols = starts_with("D"),
names_to= "Date")
long<- long %>%
mutate(Date= as.numeric(gsub("D","", Date)))
long<-long %>%
mutate(value = as.double(value))
dataready<- long %>%
mutate(across(c(Soil,Treatment),as.factor))
#percentages
dataready1<-long %>%
group_by(Soil,Treatment) %>%
summarise(germs = MaxGerm/Total)
summary(dataready1)
interaction.plot(dataready1$Soil,dataready1$Treatment,dataready1$germs)
mod_binom <- glm(cbind(MaxGerm, Total - MaxGerm) ~ Soil + Treatment,
family = binomial(link = "logit"),
data = dataready)
mod_binom_int <- glm(cbind(MaxGerm, Total - MaxGerm) ~ Soil*Treatment,
family = binomial(link = "logit"),
data = dataready)
AIC(mod_binom,mod_binom_int)
summary(mod_binom_int) #okay coefficients are weird, lets do a biasreduced fam instead
plot(mod_binom_int) #okay we are good now i think
plot(mod_br)
#### 1) Get per-row MaxGerm isince its missing , and set Total seeds = 50 ####
# Since MaxGerm is not provided, compute as the max across D1..D* columns
if (!"MaxGerm" %in% names(dat)) {
day_cols <- grep("^D\\d+$", names(dat), value = TRUE)
if (length(day_cols) == 0) stop("No MaxGerm or D1..D* columns found.")
dat <- dat %>%
mutate(
across(all_of(day_cols), ~ suppressWarnings(as.numeric(.))),
MaxGerm = do.call(pmax, c(across(all_of(day_cols)), na.rm = TRUE)))}
# Assign 50 seeds total per design
if (!"Total" %in% names(dat)) {
dat <- dat %>% mutate(Total = 50L)}
#### 2) Compute germination percentage (of 50) ####
dat <- dat %>%
mutate(germ_pct = pmin(pmax((MaxGerm / 50) * 100, 0), 100))
# 3) Clean + standardize Soil labels
dat <- dat %>%
mutate(
Soil = as.character(Soil),
Soil = trimws(Soil),
Soil = case_when(
Soil %in% c("H1", "H2", "Hester", "1") ~ "Hester Soil",
Soil %in% c("PS")                      ~ "Potting Soil",
TRUE                                   ~ Soil))
# Put Hester first, Potting Soil second
soil_levels <- c("Hester Soil", "Potting Soil",
setdiff(sort(unique(dat$Soil)), c("Hester Soil","Potting Soil")))
dat <- dat %>% mutate(Soil = factor(Soil, levels = soil_levels))
#### 4) Faceted boxplot ####
ggplot(dat, aes(x = Treatment, y = germ_pct, fill = Treatment)) +
geom_boxplot(outlier.shape = 21, alpha = 0.9) +
facet_wrap(~ Soil) +
labs(x = "Treatment", y = "Germination (%)") +
scale_y_continuous(limits = c(0, 50), breaks = seq(0, 50, 10)) +
scale_fill_viridis_c(option = "A") +  # colorblind-friendly
theme_bw() +
theme(
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold"),
legend.position = "none",
strip.text = element_text(face = "bold"),
axis.title.x = element_text(size = 12),
axis.title.y = element_text(size = 12))
dat <- dat %>% mutate(Soil = factor(Soil, levels = soil_levels))
# 3) Clean + standardize Soil labels
dat <- dat %>%
mutate(
Soil = as.character(Soil),
