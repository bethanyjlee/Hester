m1,
type = 3
)
m_glmm <- glmer(
cbind(
SeedsGerminated,
SeedsSown - SeedsGerminated
) ~
SeedSource +
Soil +
Watering +
Microtopography +
Containment +
(1|Experiment),
family = binomial,
data = dat
)
