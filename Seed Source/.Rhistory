growth ~ Soils + Tidal,
data = dataready,
family = betabinomial()
)
anova(m_bb_tid_no_int, m_bb_tid)
library(emmeans)
emm_growth_tid <- emmeans(
m_bb_tid,
~ Soils | Tidal,
type = "response"
)
summary(emm_growth_tid)
# pairwise soil comparisons within tidal category
growth_pairs <- pairs(
